{
  "compilerOptions": {
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  }
}
