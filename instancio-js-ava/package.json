{
  "name": "instancio-js-ava",
  "description": "Showcasing how to use instancio-js with ava",
  "version": "0.0.0",
  "scripts": {
    "prepare": "ts-patch install",
    "test": "ava"
  },
  "devDependencies": {
    "ava": "^6.0.0",
    "instancio-js": "^2.0.1",
    "ts-node": "^10.9.2",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "ava": {
    "files": ["instancio-ava.ts"],
    "extensions": {
      "ts": "commonjs"
    },
    "require": ["ts-node/register"]
  }
}
