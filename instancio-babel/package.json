{
  "name": "instancio-babel",
  "description": "Showcasing how to use instancio-js with babel",
  "version": "0.0.0",
  "scripts": {
    "prepare": "ts-patch install",
    "build": "tsc && babel dist/tsc --out-dir dist/babel",
    "start": "npm run build && node dist/babel/instancio-babel.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.0.0",
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "instancio-js": "^2.1.0",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  }
}
